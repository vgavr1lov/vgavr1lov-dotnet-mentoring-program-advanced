{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "IdentityServer": {
    "IssuerUri": "http://ecommerce-identity:8080",
    "Clients": {
      "Swagger": {
        "RedirectUris": [
          "http://localhost:5001/swagger/oauth2-redirect.html",
          "http://localhost:5002/swagger/oauth2-redirect.html"
        ],
        "CorsOrigins": [
          "http://localhost:5001",
          "http://localhost:5002"
        ]
      }
    }
  }
}