{
  "Logging": {
    "LogLevel": {
      "Microsoft.IdentityModel": "Trace",
      "Microsoft.AspNetCore.Authentication": "Trace"
    }
  },
  "AllowedHosts": "*",
  "LiteDb": {
    "DatabasePath": "data/carts.db"
  },
  "IdentityServer": {
    "Authority": "https://localhost:7168",
    "AuthorizeUrl": "https://localhost:7168/connect/authorize",
    "TokenUrl": "https://localhost:7168/connect/token",
    "Audience": "ecommerce.api",
    "RequireHttpsMetadata": false
  }
}
