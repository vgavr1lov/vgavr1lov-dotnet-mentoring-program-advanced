{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LiteDb": {
    "DatabasePath": "/app/data/carts.db"
  },
  "RabbitMqConfiguration": {
    "HostName": "ecommerce-rabbitmq",
    "Username": "guest",
    "Password": "guest",
    "AutomaticRecoveryEnabled": true,
    "TopologyRecoveryEnabled": true,
    "NetworkRecoveryInterval": "00:00:05"
  },
  "IdentityServer": {
    "Authority": "http://ecommerce-identity:8080",
    "AuthorizeUrl": "http://localhost:5000/connect/authorize",
    "TokenUrl": "http://localhost:5000/connect/token"
  }
} 