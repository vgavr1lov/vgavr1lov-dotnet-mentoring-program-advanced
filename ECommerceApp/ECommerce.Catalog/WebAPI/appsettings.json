{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CatalogDb": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=CatalogDb;Integrated Security=True;Encrypt=False"
  },
  "IdentityServer": {
    "Authority": "https://localhost:7168",
    "AuthorizeUrl": "https://localhost:7168/connect/authorize",
    "TokenUrl": "https://localhost:7168/connect/token",
    "Audience": "ecommerce.api",
    "RequireHttpsMetadata": false
  }
}
